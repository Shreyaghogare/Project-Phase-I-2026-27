SECRET_KEY=replace-with-a-random-secret-before-running
ADMIN_REGISTRATION_CODE=replace-with-a-private-admin-registration-code

# SMTP Configuration for Email Verification and Export Delivery
#
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   SMTP_USERNAME=your-gmail-address@gmail.com
#   SMTP_PASSWORD=your-google-app-password  # Generate from: Google Account -> Security -> 2-Step Verification -> App Passwords
#   SMTP_SENDER=your-gmail-address@gmail.com
#
# For Outlook / Microsoft 365:
#   SMTP_HOST=smtp.office365.com  # or smtp-mail.outlook.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   SMTP_USERNAME=your-outlook-email@outlook.com
#   SMTP_PASSWORD=your-outlook-password-or-app-password
#   SMTP_SENDER=your-outlook-email@outlook.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_TLS=true
